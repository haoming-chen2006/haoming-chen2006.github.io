{
  "name": "freekill-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/ensure-data.mjs && vite --host 0.0.0.0",
    "build": "npm run build:data && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "build:data": "npm run build:lua && npm run build:assets && npm run build:fonts && npm run build:overview",
    "build:lua": "node scripts/build-lua-bundle.mjs",
    "build:assets": "node scripts/build-assets.mjs",
    "build:fonts": "node scripts/build-fonts.mjs",
    "build:overview": "node scripts/build-overview.mjs",
    "spike:node": "node spike/node-run.mjs",
    "spike:all": "node spike/run-all.mjs && node spike/make-fixtures.mjs",
    "test": "vitest run",
    "deploy": "node scripts/deploy.mjs",
    "verify": "node scripts/verify-dist.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "smoke": "node scripts/smoke.mjs",
    "smoke:live": "node scripts/smoke.mjs https://haoming-chen2006.github.io/freekill/",
    "smoke:two": "node scripts/smoke-two.mjs",
    "smoke:two:live": "node scripts/smoke-two.mjs https://haoming-chen2006.github.io/freekill/",
    "audit": "node scripts/audit/run.mjs",
    "audit:live": "node scripts/audit/run.mjs --live",
    "measure": "node scripts/measure-load.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.53.0",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vite": "^5.4.11",
    "wasmoon": "^1.16.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
